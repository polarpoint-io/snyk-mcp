# Snyk API token (required)
# Get yours from: https://app.snyk.io/account
SNYK_TOKEN=your_snyk_api_token_here

# Optional: override the Snyk API URL (e.g. for self-hosted instances)
# SNYK_API_URL=https://api.snyk.io

# Transport: 'stdio' (default, for MCP clients) or 'http' (for HTTP/SSE)
TRANSPORT=stdio

# HTTP transport settings (only used when TRANSPORT=http)
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
